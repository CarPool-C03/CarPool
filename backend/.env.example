# Copia questo file in .env (che non si versiona) e adatta i valori.
# Solo valori finti: nessuna credenziale reale.

# Porta del backend (il proxy del frontend punta qui)
PORT=3000

# Database di sviluppo e di test (docker-compose.yml nella radice del repository)
DATABASE_URL=postgres://carpool:carpool@localhost:5432/carpool_dev
TEST_DATABASE_URL=postgres://carpool:carpool@localhost:5433/carpool_test

# TLS verso il database: true solo per un database in cloud
# (per le migrazioni aggiungere anche ?sslmode=require a DATABASE_URL)
DATABASE_SSL=false
