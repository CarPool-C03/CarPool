{
  "name": "carpool-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST di CarPool (Node.js + Express)",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:nuova": "node-pg-migrate create --template-file-name templates/migrazione.cjs",
    "db:seed": "node seeds/index.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.js"
    ],
    "globalSetup": "<rootDir>/test/global-setup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
